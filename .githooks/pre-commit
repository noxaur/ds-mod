#!/bin/sh
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "The working copy has changes that are not staged, and the checks would run on them instead of on the commit. Stage them, or move them out of the working copy, and commit again."
  exit 1
fi
log=$(git rev-parse --git-path check.log)
lock="$(git rev-parse --git-common-dir)/check.lock"
heavy=$(mise exec -- node scripts/affected.ts) || exit 1
# @keep Every worktree shares one lock, so parallel commits take turns on the project checks instead of starving each other.
locked() {
  command -v flock >/dev/null || { "$@"; return; }
  exec 9>"$lock"
  flock -n 9 || { echo "Another worktree is running its checks, so this commit waits for them." >&3; flock 9; } || return
  # @keep The checks close the lock's descriptor, or a Gradle daemon they start would hold the lock after the commit.
  "$@" 9>&-
}
exec 3>&2
{ mise run check:docs ::: check:comments && { [ -z "$heavy" ] || locked mise run $heavy; }; } >"$log" 2>&1 && exit 0
cat "$log"
echo "The checks failed, so nothing was committed."
exit 1
