{
  "schemaVersion": 1,
  "id": "dragen_debug",
  "version": "${version}",
  "name": "Dragen debug tools",
  "description": "Developer tools for Dragen. Bundles the release build.",
  "license": "Apache-2.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "io.github.noxaur.dragen.debug.DragenDebug"
      }
    ]
  },
  "mixins": [
    "dragen_debug.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/dragen-${version}.jar"
    }
  ],
  "depends": {
    "dragen": "${version}"
  }
}
