{
  "schemaVersion": 1,
  "id": "dragen",
  "version": "${version}",
  "name": "Dragen",
  "description": "Quality-of-life features for Dragon Simulator.",
  "license": "Apache-2.0",
  "custom": {
    "dragen:backend": "${backend_url}",
    "dragen:website": "${website_url}"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "io.github.noxaur.dragen.edge.DragenClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "io.github.noxaur.dragen.edge.ModMenu"
      }
    ]
  },
  "accessWidener": "dragen.accesswidener",
  "mixins": [
    "dragen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}
